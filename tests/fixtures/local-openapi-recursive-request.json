{
  "openapi": "3.1.0",
  "info": {
    "title": "Recursive request example",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://example.test"
    }
  ],
  "paths": {
    "/nodes": {
      "post": {
        "operationId": "createNode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Node"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Node": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "children"
            ],
            "properties": {
              "kind": {
                "const": "branch"
              },
              "children": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/Node"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "const": "leaf"
              },
              "value": {
                "type": "string",
                "minLength": 4
              }
            }
          }
        ]
      }
    }
  }
}
